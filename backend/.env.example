# Copy to .env and fill in real values. Never commit .env itself.

PORT=8089
MONGODB_URI=mongodb://localhost:27017/fittrack

# Signs and verifies auth tokens. Use a long random string — changing it
# invalidates every existing session.
JWT_SECRET=replace_with_a_long_random_secret

# Origin the frontend is served from. Used to build password-reset links and
# Khalti return URLs, so it must match where the app actually runs.
FRONTEND_ORIGIN=http://localhost:3000

# Khalti sandbox credentials. No default is baked into the code — payment
# routes return 500 until KHALTI_SECRET_KEY is set.
KHALTI_SECRET_KEY=your_khalti_sandbox_key
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# Gmail account used for password-reset mail. EMAIL_PASS must be a Google
# "app password", not the account password.
EMAIL_USER=your_gmail_address
EMAIL_PASS=your_gmail_app_password
