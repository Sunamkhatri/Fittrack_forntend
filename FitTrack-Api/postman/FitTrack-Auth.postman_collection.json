{
  "info": {
    "name": "FitTrack Auth API",
    "description": "Sprint 2 — Registration & Login endpoints. Register and Login both return a JWT token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8089" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('Token is generated', () => {",
              "    const token = pm.response.json().data.token;",
              "    pm.expect(token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token', token);",
              "});",
              "pm.test('User object returned without password', () => {",
              "    const user = pm.response.json().data.user;",
              "    pm.expect(user).to.have.property('email');",
              "    pm.expect(user).to.not.have.property('password');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.smith@fittrack.com\",\n  \"username\": \"janesmith\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Token is generated', () => {",
              "    const token = pm.response.json().data.token;",
              "    pm.expect(token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token', token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane.smith@fittrack.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    }
  ]
}
